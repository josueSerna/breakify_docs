---
interface Feature {
	icon: string;
	title: string;
	description: string;
}

interface Props {
	features: Feature[];
}

const { features } = Astro.props;
---

<div class="feature-grid">
	{features.map((feature) => (
		<article class="feature-card">
			<div class="feature-card__icon" aria-hidden="true">{feature.icon}</div>
			<h3>{feature.title}</h3>
			<p>{feature.description}</p>
		</article>
	))}
</div>
