---
interface Props {
	compact?: boolean;
	footer?: boolean;
}

const { compact = false, footer = false } = Astro.props;
---

<a class:list={['brand-mark', { 'brand-mark--compact': compact }]} href="/" aria-label="Breakify home">
	<img src={footer ? '/images/breakify_logo_blanco.png' : '/images/breakify_logo.png'} alt="Breakify" />
</a>
