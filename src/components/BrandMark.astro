---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class:list={['brand-mark', { 'brand-mark--compact': compact }]} href="/" aria-label="Breakify home">
	<span class="brand-mark__symbol" aria-hidden="true">&lt;/&gt;</span>
	<span class="brand-mark__name">Breakify</span>
</a>
