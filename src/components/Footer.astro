---
import BrandMark from './BrandMark.astro';

const localePrefix = Astro.url.pathname.startsWith('/es/') ? '/es' : '';
---

<footer class="site-footer">
	<div class="footer-inner">
		<div>
			<BrandMark footer />
			<p class="footer-copy">A clearer way to build responsive Flutter interfaces.</p>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href="https://github.com/josueSerna/breakify">GitHub</a>
			<a href="https://pub.dev/packages/breakify">pub.dev</a>
			<a href={`${localePrefix}/introduction/`}>{localePrefix ? 'Documentación' : 'Documentation'}</a>
			<a href="https://www.linkedin.com/in/josue-serna-munoz/">LinkedIn</a>
		</nav>
	</div>
	<div class="footer-bottom">
		<span>© {new Date().getFullYear()}. All rights reserved.</span>
		<span>Built for thoughtful Flutter developers.</span>
	</div>
</footer>
